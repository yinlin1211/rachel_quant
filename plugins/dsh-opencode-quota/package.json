{
  "name": "dsh-plugin-opencode-quota",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode Go 额度徽标：按本地会话用量估算 5 小时 / 本周 / 本月已占额度",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/quota.mjs"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
